# Copy to .env (next to this file) and fill in. Keys stay on the PC: nothing here is ever sent to the robot.
# Values in .env win over Windows environment variables of the same name.

# Sai (Simular) API - create a key at https://platform.simular.ai
SAI_API_KEY=
# Needed only if you have several Sai machines: which one does the work (they are listed in runtime/brain.log)
SAI_MACHINE_ID=

# OpenRouter key: the conversation model, vision and speech-to-text go through it
OPENROUTER_API_KEY=

# Shared secret between the robot and the gateway (any long random string; see "Pin the robot" in the README)
STACKCHAN_TOKEN=

# Optional settings
# SAI_BRAIN_MODEL=anthropic/claude-haiku-5.5
# SAI_STT_MODEL=openai/gpt-4o-mini-transcribe
# SAI_VOICE=en-US-AnaNeural
# SAI_PC_IP=192.168.1.20        # detected automatically; set it if the PC has several networks
# SAI_YAW_OFFSET=0              # head calibration in degrees (see the README)
# SAI_PITCH_OFFSET=0
# SAI_PITCH_MAX=80
# SAI_SAVE_CAPTURES=0           # 1 = keep every recording in runtime/captures for debugging
